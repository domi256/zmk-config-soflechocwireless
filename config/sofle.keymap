#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>

/* DEUTSCHES LAYOUT ALIASE */
#define DE_Z    Y
#define DE_Y    Z
#define DE_ADIA SEMI
#define DE_ODIA SQT
#define DE_UDIA LBKT
#define DE_SS   MINUS
#define DE_CIRC GRAVE
#define DE_PLUS RBKT
#define DE_HASH NON_US_HASH
#define DE_LESS NON_US_BSLH

/ {
    macros {
        moom: moom {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LCTRL &kp LALT &kp LGUI &kp DOWN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "BASE";
            // Zeile 0: 12 Tasten
            // Zeile 1: 12 Tasten
            // Zeile 2: 12 Tasten
            // Zeile 3: 14 Tasten (inkl. Encoder-Knöpfe in der Mitte)
            // Zeile 4: 10 Tasten (Daumenreihe)
            bindings = <
&kp DE_CIRC &kp N1     &kp N2    &kp N3    &kp N4    &kp N5                            &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp DE_SS
&kp ESC     &kp Q      &kp W     &kp E     &kp R     &kp T                             &kp DE_Z  &kp U     &kp I     &kp O     &kp P     &kp BSPC
&kp TAB     &kp A      &kp S     &kp D     &kp F     &kp G                             &kp H     &kp J     &kp K     &kp L     &kp DE_ODIA &kp DE_ADIA
&kp LSHFT   &kp DE_Y   &kp X     &kp C     &kp V     &kp B     &kp C_MUTE    &kp C_PP  &kp N     &kp M     &kp COMMA &kp DOT   &kp SLASH &kp RSHFT
                       &kp LCTRL &mo 2     &kp LCMD  &kp SPACE &kp ENTER     &kp RALT &kp SPACE &kp RCMD  &mo 1     &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp UP DOWN &inc_dec_kp LEFT RIGHT>;
        };

        lower_layer {
            label = "LOWER";
            bindings = <
&kp F1      &kp F2     &kp F3    &kp F4    &kp F5    &kp F6                            &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
&trans      &kp EXCL   &kp RA(L) &kp RA(N7) &kp RA(N0) &kp RA(NON_US_BSLH)              &kp STAR  &kp N7    &kp N8    &kp N9    &kp DE_PLUS &kp DEL
&kp SQT     &kp DE_HASH &kp DLLR  &kp RA(N8) &kp RA(N9) &kp RA(RBKT)                   &kp SLASH &kp N4    &kp N5    &kp N6    &kp MINUS &kp DE_UDIA
&moom       &kp PRCNT  &kp DE_CIRC &kp RA(N5) &kp RA(N6) &kp RA(Y)    &trans &trans    &kp N0    &kp N1    &kp N2    &kp N3    &kp EQUAL &trans
                       &trans    &trans    &trans    &trans    &trans        &trans    &trans    &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_NEXT C_PREV>;
        };

        raise_layer {
            label = "RAISE";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4           &rgb_ug RGB_TOG &rgb_ug RGB_EFF &rgb_ug RGB_BRI &rgb_ug RGB_BRD &trans &kp DE_QUES
&trans      &trans     &kp END   &kp UP    &kp HOME  &kp PG_UP                         &trans    &trans    &kp UP    &trans    &trans    &kp DEL
&trans      &trans     &kp RIGHT &kp DOWN  &kp LEFT  &kp PG_DN                         &trans    &kp LEFT  &kp DOWN  &kp RIGHT &trans    &trans
&trans      &trans     &kp DE_LESS &trans  &trans    &trans    &kp LC(LG(Q)) &trans    &trans    &trans    &trans    &trans    &trans    &trans
                       &trans    &trans    &trans    &trans    &trans        &trans    &trans    &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp UP DOWN &inc_dec_kp LEFT RIGHT>;
        };
    };
};